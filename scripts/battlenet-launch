#!/usr/bin/env bash
#
# battlenet-launch
#
# Starts Battle.net from its Proton prefix. A thin wrapper around
# proton-launch, which carries all the shared Wine and Proton setup.
# See chapter 16 for why these launchers exist at all: the Lutris installer
# builds a working prefix and then fails to write a game record, so there is
# nothing to launch from.

set -euo pipefail

PREFIX="${BATTLENET_PREFIX:-/mnt/modded/Battle.net}"
EXE="$PREFIX/drive_c/Program Files (x86)/Battle.net/Battle.net Launcher.exe"

# Battle.net specific quirks, kept here rather than in the shared script.
# Disabling locationapi avoids a stall some builds hit on the login page, and
# the writecopy flag was part of the combination that first got the login page
# rendering. Neither was isolated, so both are carried.
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-locationapi=}"
export WINE_SIMULATE_WRITECOPY="${WINE_SIMULATE_WRITECOPY:-1}"

exec proton-launch --prefix "$PREFIX" --exe "$EXE" -- "$@"
